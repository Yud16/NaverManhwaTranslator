GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-lite-latest
HOST=127.0.0.1
PORT=8000
# Minimum seconds between Gemini calls (paces requests under the free-tier
# RPM cap). Raise this if you still see rate-limit retries in the logs.
GEMINI_MIN_INTERVAL_SECONDS=7
GEMINI_MAX_RETRIES=6
# How many panel images go into one Gemini call. The free tier's daily cap
# is on request count, not per-request size, so raising this cuts Gemini
# calls roughly proportionally — at the cost of a bigger blast radius if
# one call fails and (past some point) the model losing track of which
# image is which.
GEMINI_BATCH_SIZE=5
# How many detected text lines go into one Gemini translation call (used
# when the detector isn't Gemini but the engine is, e.g. PaddleOCR detector
# + Gemini engine). Text lines are much lighter than whole images, so this
# can safely be larger than GEMINI_BATCH_SIZE above — raising it further
# cuts Gemini calls roughly proportionally, at the cost of a bigger blast
# radius if one call fails.
GEMINI_TEXT_BATCH_SIZE=30
# Optional — only needed to use the "azure" translation engine. Get these by
# creating a free Translator resource (F0 tier, 2M free chars/month) at
# portal.azure.com > Create a resource > Translator. AZURE_TRANSLATOR_REGION
# is the region you picked when creating the resource (e.g. "eastus") —
# leave it blank if you created a "Global" resource.
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=
# Optional — only needed to use the "deepl" translation engine. Get one at
# deepl.com/your-account/keys. Free-tier keys end in ":fx" and are detected
# automatically to hit the correct (free vs. paid) API host.
DEEPL_API_KEY=
# PaddleOCR (the default detector) drops any text region read below this
# confidence rather than showing it — in testing this is what separates real
# dialogue (94%+) from stylized SFX lettering it garbles (<70%). Lower this
# if it's missing text you want to see; raise it if it's showing garbage.
PADDLE_MIN_CONFIDENCE=0.85
